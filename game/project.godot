; Engine configuration file.
; 《晚自习之后》 After Evening Study
; Godot Engine 4.7.1 stable / Mobile

config_version=5

[application]

config/name="晚自习之后"
config/description="国产校园恐怖文字互动视觉小说（完整版）"
config/version="1.0.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.03, 0.03, 0.04, 1)
boot_splash/show_image=false

[autoload]

Cfg="*res://autoload/config.gd"
GameState="*res://autoload/game_state.gd"
StoryEngine="*res://autoload/story_engine.gd"
AudioDirector="*res://autoload/audio_director.gd"
SaveSystem="*res://autoload/save_system.gd"
ArtCache="*res://autoload/art_cache.gd"
Integrity="*res://autoload/integrity_manifest.gd"
ContentPolicy="*res://autoload/content_policy.gd"
Workshop="*res://autoload/workshop.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.03, 0.03, 0.04, 1)
; MSAA 关闭：本作是纯 2D 图片合成，没有需要抗锯齿的斜边几何，
; 开 2x MSAA 只是让整个 viewport 多一遍解析，中低端手机上白掉帧。
anti_aliasing/quality/msaa_2d=0

[gui]

theme/default_font_multichannel_signed_distance_field=true

[physics]

common/physics_ticks_per_second=60
